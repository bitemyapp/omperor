{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omperor eval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace",
    "model",
    "prompt"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "Existing absolute directory; use an isolated checkout."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!mock/)"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "thinking_level": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "data_dir": {
      "type": [
        "string",
        "null"
      ],
      "description": "Absolute OMP data-store location; defaults to Omperor Dev's store, including from a production executable."
    },
    "computer_use": {
      "type": "boolean",
      "default": false
    },
    "timeout_secs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 300
    },
    "checks": {
      "type": "array",
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "const": "answer_contains"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "argv"
            ],
            "properties": {
              "type": {
                "const": "command"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ],
                "items": {
                  "type": "string"
                }
              },
              "timeout_secs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600,
                "default": 300
              }
            }
          }
        ]
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Variables for the agent's tools and the graders, e.g. offline flags. Omperor's data-store pins always win."
    },
    "diff_baseline": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "A commit in the workspace; once the agent stops and before graders run, its changes against this commit are recorded in changes.patch and result.changes."
    }
  }
}
