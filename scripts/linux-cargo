#!/usr/bin/env bash
# Build with Sidestep's objc2 fixes without changing macOS's dependency sources.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"
if [[ $# -eq 0 ]]; then
    echo "usage: scripts/linux-cargo <build|check|test|run|clippy> [cargo arguments]" >&2
    exit 2
fi
COMMAND="$1"
shift
OVERLAY_DIR="$PROJECT_DIR/.objc2-overlay"
mkdir -p "$OVERLAY_DIR"
exec 9>"$OVERLAY_DIR/.linux-build.lock"
flock 9
CONFIG_FILE="$(mktemp "$OVERLAY_DIR/cargo.XXXXXX.toml")"
trap 'rm -f "$CONFIG_FILE"' EXIT
cargo run --quiet --release --locked \
    --manifest-path vendor/sidestep/tools/objc2-overlay/Cargo.toml -- \
    --out "$OVERLAY_DIR" --quiet > "$CONFIG_FILE"
printf '\n[profile.dev.package.tiny-skia]\noverflow-checks = false\n' >> "$CONFIG_FILE"
python3 scripts/linux-prepare.py
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PROJECT_DIR/target}"
export OMPEROR_SOURCE_DIR="$PROJECT_DIR"
status=0
# After the subcommand, so that external subcommands such as clippy pass the
# overlay on to the cargo they run.
cargo "$COMMAND" --config "$CONFIG_FILE" --manifest-path "$OVERLAY_DIR/omperor/Cargo.toml" "$@" || status=$?
cp "$OVERLAY_DIR/omperor/Cargo.lock" "$PROJECT_DIR/Cargo.linux.lock"
exit "$status"
