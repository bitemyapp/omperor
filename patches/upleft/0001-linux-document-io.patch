 fn renamex(from: &Path, to: &Path, flags: libc::c_uint) -> libc::c_int {
     let (Ok(from), Ok(to)) =
         (std::ffi::CString::new(from.as_os_str().as_bytes()), std::ffi::CString::new(to.as_os_str().as_bytes()))
     else {
