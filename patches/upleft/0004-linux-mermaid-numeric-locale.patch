+/// A valid immutable C locale for Linux's numeric parser.
+#[cfg(target_os = "linux")]
+fn c_numeric_locale() -> *mut std::ffi::c_void {
+    // Unlike Darwin, glibc requires a live locale_t for strtod_l. Keep an
+    // immutable C locale for the process lifetime so parallel diagram workers
+    // share it without changing the caller's thread or global locale.
+    static LOCALE: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *LOCALE.get_or_init(|| {
+        // SAFETY: the name is NUL-terminated, the mask is valid, and a null
+        // base asks newlocale to allocate a new locale (all other categories C).
+        let locale = unsafe { libc::newlocale(libc::LC_NUMERIC_MASK, c"C".as_ptr(), std::ptr::null_mut()) };
+        assert!(!locale.is_null(), "cannot create the C numeric locale");
+        locale as usize
+    }) as *mut std::ffi::c_void
+}
