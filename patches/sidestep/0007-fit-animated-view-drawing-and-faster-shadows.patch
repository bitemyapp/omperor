+/// Whether `m` takes image pixels to device pixels one to one: a whole
+/// number of pixels across and down, mirrored or not, without scaling.
+fn one_to_one(m: &Transform) -> bool {
+    let whole = |v: f32| (v - v.round()).abs() < 1e-3;
