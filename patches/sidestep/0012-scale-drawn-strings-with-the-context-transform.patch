+/// the view's transform (`xf` after the scale `k`) and clip.
+fn placement(xf: Xf, k: f64, clip: Rect, place: Place, laid: &TextLayout) -> (f32, f32, Rect) {
+    let point = |x: f64, y: f64| xf.point(k * x, k * y);
