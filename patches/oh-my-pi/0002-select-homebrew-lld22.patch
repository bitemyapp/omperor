diff --git a/crates/py/scripts/ld64.lld b/crates/py/scripts/ld64.lld
index 1ed823279b..1dbc0a0a6d 100755
--- a/crates/py/scripts/ld64.lld
+++ b/crates/py/scripts/ld64.lld
@@ -4,6 +4,11 @@
 # that bitcode, and rustc's rust-lld (LLVM 23) mis-resolves a handful of
 # symbols in it; the producer-matched major is the one that links clean.
-LLD=/opt/homebrew/opt/lld/bin/ld64.lld
+VERSIONED_LLD=/opt/homebrew/opt/lld@22/bin/ld64.lld
+if [[ -x "$VERSIONED_LLD" ]]; then
+	LLD=$VERSIONED_LLD
+else
+	LLD=/opt/homebrew/opt/lld/bin/ld64.lld
+fi
 case "$("$LLD" --version 2>/dev/null)" in
 	*"LLD 22."*) ;;
 	*)
