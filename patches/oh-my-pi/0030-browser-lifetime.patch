+	#[test]
+	#[ignore = "requires an installed headless browser engine"]
+	fn browsers_do_not_outlive_their_daemon_process() {
+		let output = Command::new(std::env::current_exe().expect("test executable"))
+			.args(["daemon_exit_subprocess_helper", "--nocapture", "--include-ignored"])
+			.env("OMP_BROWSER_EXIT_HELPER", "1")
+			.output()
+			.expect("helper");
+		let stdout = String::from_utf8_lossy(&output.stdout);
+		let launched = stdout
+			.lines()
+			.find_map(|line| line.strip_prefix("browsers "))
+			.expect("helper reports its browsers")
+			.trim_matches(['[', ']'])
+			.split(", ")
+			.filter_map(|pid| pid.parse::<i32>().ok())
+			.collect::<Vec<_>>();
+		assert!(!launched.is_empty(), "the tab launched a browser: {stdout}");
+		// SAFETY: signal 0 only asks whether the process still exists.
+		let alive = |pid: i32| unsafe { libc::kill(pid, 0) } == 0;
+		let deadline = Instant::now() + Duration::from_secs(5);
+		while launched.iter().any(|pid| alive(*pid)) && Instant::now() < deadline {
+			thread::sleep(Duration::from_millis(50));
+		}
+		let orphaned = launched
+			.into_iter()
+			.filter(|pid| alive(*pid))
+			.collect::<Vec<_>>();
+		for pid in &orphaned {
+			// SAFETY: these are browsers this test's helper launched.
+			unsafe { libc::kill(*pid, libc::SIGKILL) };
+		}
+		assert!(orphaned.is_empty(), "browsers {orphaned:?} outlived their daemon process");
+	}
