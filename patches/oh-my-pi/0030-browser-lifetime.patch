+impl Drop for BrowserDaemon {
+	/// Wait for the actor to close its tabs and the browsers it launched. Left
+	/// to itself it was cut off when the process exited, orphaning every
+	/// browser (headless or windowed) along with its memory.
+	fn drop(&mut self) {
+		if self.requests.send(Request::Stop).is_ok()
+			&& self.stopped.recv_timeout(STOP_TIMEOUT).is_err()
+		{
+			tracing::warn!("browser daemon did not close its tabs before shutdown");
+		}
 	}
 }
 
