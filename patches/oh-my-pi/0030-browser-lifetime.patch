+				relay_url: Str::default(),
+			});
+		let mut open = params(Action::Open);
+		open.name = Some(sf!("lifetime"));
+		open.url = Some(sf!("about:blank"));
+		let (updates, _receiver) = flume::unbounded();
+		tokio::runtime::Builder::new_current_thread()
+			.enable_all()
+			.build()
+			.expect("runtime")
+			.block_on(daemon.execute(sf!("owner"), open, CancellationToken::new(), updates))
+			.expect("open tab");
+		println!("browsers {:?}", browser_children(std::process::id()));
+		drop(daemon);
+		std::process::exit(0);
+	}
