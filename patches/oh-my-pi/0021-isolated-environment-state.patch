+				.env("OMP_DATA_DIR", namespace)
+				.env("OMP_PROFILE", "default")
+				.env("OMP_TEST_AUTHORITY_MODE", mode)
+				.stdout(Stdio::null())
+				.spawn()
+				.expect("spawn authority child"),
