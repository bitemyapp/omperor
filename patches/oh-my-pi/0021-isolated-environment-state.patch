+		};
+		struct ChildGuard(Child);
+		impl Drop for ChildGuard {
+			fn drop(&mut self) {
+				let _ = self.0.kill();
+				let _ = self.0.wait();
+			}
+		}
+		let mut child = ChildGuard(
