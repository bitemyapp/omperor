+	struct WaitingDevice {
+		observe_interrupts: bool,
+		spec:               ToolSpec,
+		started:            flume::Sender<()>,
+		complete:           flume::Receiver<()>,
+		interrupted:        Arc<AtomicUsize>,
+	}
+
+	impl Tool for WaitingDevice {
+		type Fault = Value;
+		type Params = Value;
+		type Payload = Value;
+		type Update = Value;
+
+		fn spec(&self) -> &ToolSpec {
+			&self.spec
+		}
+
+		fn call<'c>(
+			&'c self,
+			mut incoming: IncomingParams<'c>,
+		) -> impl Stream<Item = Ev<Value, Value, Value>> + Send + 'c {
+			async_stream::stream! {
+				incoming.committed().await.expect("committed device arguments");
+				self.started.send(()).expect("test observes execution");
+				tokio::select! {
+					biased;
+					interrupt = incoming.next_interrupt(), if self.observe_interrupts => {
+						let abort = match interrupt {
+							Ok(interrupt) => {
+								self.interrupted.fetch_add(1, Ordering::Relaxed);
+								omp_tool::Abort::Interrupted { reason: interrupt.reason }
+							},
+							Err(_) => omp_tool::Abort::InputDropped,
+						};
+						yield Ev::Aborted(abort);
+					},
+					_ = self.complete.recv_async() => {
+						yield Ev::Done(omp_tool::ToolTerminal::Done {
+							result: Ok(json!({"ok": true})),
+							useless: false,
+						});
+					},
+				}
+			}
+		}
+
+		fn prompt(&self, view: Result<&Value, &Value>, _caps: &PromptCaps) -> Vec<Part> {
+			vec![Part::Json { json: Bytes::from(serde_json::to_vec(view.unwrap()).unwrap()) }]
+		}
+	}
+
+	fn waiting_device_host(
+		scratch: &std::path::Path,
+		observe_interrupts: bool,
+	) -> (DynHost, Arc<Registry>, flume::Receiver<()>, flume::Sender<()>, Arc<AtomicUsize>) {
+		let (started, observed) = flume::bounded(1);
+		let (complete, completion) = flume::bounded(1);
+		let interrupted = Arc::new(AtomicUsize::new(0));
+		let mut registry = Registry::new();
+		registry
+			.register(
+				WaitingDevice {
+					observe_interrupts,
+					spec: ToolSpec {
+						name:            sf!("waiting"),
+						rev:             Rev { family: sf!("test"), n: 1 },
+						description:     sf!("Device that waits for completion or cancellation"),
+						schema:          Bytes::from_static(br#"{"type":"object","properties":{}}"#),
+						constraint:      Constraint::None,
+						effects:         Effects::empty(),
+						projection_code: [1; 32],
+					},
+					started,
+					complete: completion,
+					interrupted: Arc::clone(&interrupted),
+				},
+				Presentation::Device,
+				Claims {
+					precedence: Precedence::ENHANCEMENT,
+					claimant:   sf!("omp/test"),
+					replaces:   None,
+				},
+			)
+			.expect("register waiting device");
+		let catalog = DeviceCatalog::default();
+		let registry = Arc::new(registry);
+		catalog
+			.install_registry(Arc::clone(&registry))
+			.expect("install catalog");
+		let mcp = McpManager::new(
+			McpService::open(scratch.join("mcp.sqlite3")).expect("MCP service"),
+			Arc::new(ProductionConnector::new(scratch.to_path_buf())),
+			Arc::from([]),
+			scratch.join("local"),
+		);
+		let host = DynHost::new(
+			catalog,
+			Arc::new(NoWorker),
+			StagedProposalRegistry::new(),
+			Arc::new(HookGate::channel().0),
+			BlobHost::open(scratch.join("blobs")).expect("blobs"),
+			mcp,
+			DynamicAdmission::new(ApprovalMode::Yolo, Default::default(), None),
+		);
+		(host, registry, observed, complete, interrupted)
+	}
+
+	#[tokio::test]
+	async fn native_device_keeps_committed_input_alive_until_completion() {
+		let scratch = tempfile::tempdir().expect("scratch");
+		let (host, _registry, started, complete, interrupted) =
+			waiting_device_host(scratch.path(), true);
+		let invocation = tokio::spawn(async move {
+			ShellDynHost::call(&host, "waiting", json!({}), CancellationToken::new()).await
+		});
+		tokio::time::timeout(std::time::Duration::from_secs(2), started.recv_async())
+			.await
+			.expect("device starts")
+			.expect("start notification");
+		complete.send(()).expect("complete device");
+		let result = tokio::time::timeout(std::time::Duration::from_secs(2), invocation)
+			.await
+			.expect("device settles")
+			.expect("invocation task")
+			.expect("successful device");
+		assert_eq!(result.output, DynOutput::Json(json!({"ok": true})));
+		assert_eq!(interrupted.load(Ordering::Relaxed), 0);
+	}
+
+	#[tokio::test]
+	async fn native_device_relays_cancellation_before_releasing_input() {
+		let scratch = tempfile::tempdir().expect("scratch");
+		let (host, _registry, started, _complete, interrupted) =
+			waiting_device_host(scratch.path(), true);
+		let cancellation = CancellationToken::new();
+		let call_cancellation = cancellation.clone();
+		let invocation = tokio::spawn(async move {
+			ShellDynHost::call(&host, "waiting", json!({}), call_cancellation).await
+		});
+		tokio::time::timeout(std::time::Duration::from_secs(2), started.recv_async())
+			.await
+			.expect("device starts")
+			.expect("start notification");
+		cancellation.cancel();
+		let result = tokio::time::timeout(std::time::Duration::from_secs(2), invocation)
+			.await
+			.expect("cancellation settles")
+			.expect("invocation task");
+		assert!(result.is_err(), "cancelled device must fail its shell invocation");
+		assert_eq!(interrupted.load(Ordering::Relaxed), 1);
+	}
+
+	#[tokio::test]
+	async fn native_device_cancellation_does_not_wait_forever_for_cleanup() {
+		let scratch = tempfile::tempdir().expect("scratch");
+		let (host, _registry, started, _complete, interrupted) =
+			waiting_device_host(scratch.path(), false);
+		let cancellation = CancellationToken::new();
+		let call_cancellation = cancellation.clone();
+		let invocation = tokio::spawn(async move {
+			ShellDynHost::call(&host, "waiting", json!({}), call_cancellation).await
+		});
+		tokio::time::timeout(std::time::Duration::from_secs(2), started.recv_async())
+			.await
+			.expect("device starts")
+			.expect("start notification");
+		cancellation.cancel();
+		let result = tokio::time::timeout(std::time::Duration::from_secs(2), invocation)
+			.await
+			.expect("uncooperative device cancellation is bounded")
+			.expect("invocation task");
+		assert!(result.is_err());
+		assert_eq!(interrupted.load(Ordering::Relaxed), 0);
+	}
+
