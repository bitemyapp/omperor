 #[cfg(test)]
 mod tests {
+
+	#[test]
+	fn a_daemon_for_an_isolated_copy_exits_once_idle() {
+		let directory = tempfile::tempdir().expect("tempdir");
+		assert_eq!(super::isolated_daemon_idle_timeout(directory.path(), None), None);
+		assert_eq!(super::isolated_daemon_idle_timeout(directory.path(), Some(30)), Some(30));
+		std::fs::write(directory.path().join(omp_walker::ISOLATION_ROOT_MARKER), "{}").expect("marker");
+		assert_eq!(super::isolated_daemon_idle_timeout(directory.path(), None), Some(1));
+		assert_eq!(super::isolated_daemon_idle_timeout(directory.path(), Some(30)), Some(30));
+	}
