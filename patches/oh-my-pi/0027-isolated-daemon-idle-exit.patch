+/// The idle timeout for the environment daemon a kernel attaches to. A child
+/// kernel on an isolated copy of the workspace inherits no host options, so
+/// its daemon was spawned with none and outlived the child, its copy, and the
+/// host process. A daemon for an isolated root exits as soon as nothing is
+/// attached to it.
+fn isolated_daemon_idle_timeout(project_root: &Path, configured: Option<u64>) -> Option<u64> {
+	configured.or_else(|| project_root.join(omp_walker::ISOLATION_ROOT_MARKER).is_file().then_some(1))
+}
